# EXEMPLO PUBLICO: substitua os valores localmente. NUNCA envie o .env real ao GitHub.
PORT=9090
DOMAIN=localhost
AUTH=replace-with-a-long-random-secret

# MariaDB (exemplo local, sem credenciais reais)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=queue_work_go
DB_USER=queue_user
DB_PASSWORD=replace-with-a-strong-password

# API externa opcional: usada apenas por plugins que a exigem
API_URL_1=https://api.example.com
API_KEY_1=replace-with-an-api-key

